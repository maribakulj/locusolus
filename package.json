{
  "name": "locusolus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Locus Solus — laboratoire et control plane. Monorepo.",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run check:format && npm run check:repo && npm run check:naming && npm run check:boundaries && npm run typecheck && npm test",
    "check:format": "prettier --check .",
    "check:repo": "node tooling/repo/check-repo.ts",
    "check:naming": "node tooling/repo/check-naming.ts",
    "check:boundaries": "node tooling/boundaries/check-boundaries.ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
